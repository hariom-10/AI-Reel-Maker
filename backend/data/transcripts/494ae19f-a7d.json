{"version": 1, "signature": "820529a19f58f536939d1a8ba215f673950fb08b9d52deda3baa49c1e5d0da5e", "segments": [{"id": "sub_1", "start_time": 0.0, "end_time": 2.0, "text": "میں اٹھر تھا تنچکوں کے نہیں"}, {"id": "sub_2", "start_time": 2.0, "end_time": 3.0, "text": "پر امید توتي"}, {"id": "sub_3", "start_time": 3.0, "end_time": 5.0, "text": "میں تو بھی کچھ دکھانا چاہتا تھا"}, {"id": "sub_4", "start_time": 5.0, "end_time": 8.0, "text": "اور کوئی ہے بھی دنی میری پاس"}, {"id": "sub_5", "start_time": 9.0, "end_time": 12.0, "text": "میں ایک سے راستبان سے گیرتیوی"}, {"id": "sub_6", "start_time": 12.0, "end_time": 14.0, "text": "اور کھوں کے بارے میں سوشتا"}, {"id": "sub_7", "start_time": 14.0, "end_time": 15.0, "text": "صرف ناش"}, {"id": "sub_8", "start_time": 15.0, "end_time": 16.0, "text": "سب کھتن"}, {"id": "sub_9", "start_time": 16.0, "end_time": 17.0, "text": "نہیں شرواد"}, {"id": "sub_10", "start_time": 17.0, "end_time": 19.0, "text": "دنی رکہ صفایا"}, {"id": "sub_11", "start_time": 19.0, "end_time": 22.0, "text": "باکی ایک نی بھی ہی سے νیزیر سے آنسکے"}, {"id": "sub_12", "start_time": 22.0, "end_time": 24.0, "text": "مجھے بھی نیے بنا تھا"}, {"id": "sub_13", "start_time": 25.0, "end_time": 28.0, "text": "مجھے بھی خوبصورت بنا تھا"}, {"id": "sub_14", "start_time": 28.0, "end_time": 31.1, "text": "hing tesim"}, {"id": "sub_15", "start_time": 30.46, "end_time": 44.4, "text": "Als has\\'"}, {"id": "sub_16", "start_time": 49.4, "end_time": 50.8, "text": "Bab yvat"}, {"id": "sub_17", "start_time": 50.8, "end_time": 53.86, "text": "ада這 месте"}]}